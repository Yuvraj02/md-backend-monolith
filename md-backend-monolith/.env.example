APP_ENV=production
SERVICE_NAME=md-backend-monolith
HTTP_PORT=8080
SHUTDOWN_TIMEOUT=15s

CORS_ALLOWED_ORIGINS=*
OWNER_STUDIO_SECRET=generated-by-setup-db

DATABASE_HOST=ep-xxxx.region.aws.neon.tech
DATABASE_PORT=5432
DATABASE_NAME=neondb
DATABASE_USER=marketing_digest
DATABASE_PASSWORD=generated-by-setup-db
DATABASE_SSLMODE=require

DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=2
DB_CONN_MAX_LIFETIME=30m

# Admin URL used by scripts/setup-db.sh (do not commit .env)
# ADMIN_DATABASE_URL=postgres://neondb_owner:...@.../neondb?sslmode=require
